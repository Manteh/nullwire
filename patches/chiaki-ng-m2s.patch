+// Called on the video thread for every decoded frame. Does nothing unless a calibration is running.
+extern "C" void m2s_calib_on_frame(AVFrame *f)
+{
+	if(!f || (!g_m2s_calib.active() && !g_m2s_frame_wanted.load()))
+		return;
+	AVFrame *sw = nullptr;
+	const AVFrame *use = f;
+	if(f->hw_frames_ctx)
+	{
+		sw = av_frame_alloc();
+		if(!sw || av_hwframe_transfer_data(sw, f, 0) < 0) { av_frame_free(&sw); return; }
+		use = sw;
+	}
+	int step = 0, offset = 0;
+	switch(use->format)
+	{
+		case AV_PIX_FMT_NV12: case AV_PIX_FMT_YUV420P: case AV_PIX_FMT_YUVJ420P: step = 1; break;
+		case AV_PIX_FMT_P010LE: step = 2; offset = 1; break;
+		default: { static bool said = false; if(!said) { said = true; fprintf(stderr, "[m2s] calibration: unsupported video format %d\n", use->format); } }
+	}
+	if(step && g_m2s_calib.active())
+		g_m2s_calib.onFrame(use->data[0], use->width, use->height, use->linesize[0], m2sNow(), step, offset);
+	if(step && g_m2s_frame_wanted.load())
+	{
+		std::lock_guard<std::mutex> l(g_m2s_test_mtx);
+		if(!g_m2s_shot_path.empty())
+		{
+			if(FILE *o = fopen(g_m2s_shot_path.c_str(), "wb"))
+			{
+				fprintf(o, "P5\n%d %d\n255\n", use->width, use->height);
+				for(int y = 0; y < use->height; y++)
+				{
+					const uint8_t *r = use->data[0] + y * use->linesize[0];
+					for(int x = 0; x < use->width; x++) fputc(r[x * step + offset], o);
+				}
+				fclose(o);
+			}
+			g_m2s_shot_path.clear();
+		}
+		if(g_m2s_t2d_on && g_m2s_t2d)
+		{
+			g_m2s_t2d->feed(use->data[0], use->width, use->height, use->linesize[0], step, offset);
+			g_m2s_seen.push_back({m2sNow(), g_m2s_t2d->x(), g_m2s_t2d->y()});
+			if(g_m2s_trace && g_m2s_seen.size() > 2400) g_m2s_seen.erase(g_m2s_seen.begin(), g_m2s_seen.begin() + 1200);
+		}
+		if(g_m2s_track_on)
+		{
+			double p[m2s::AutoCalib::N], sh = 0;
+			double contrast = m2s::AutoCalib::profile(use->data[0], use->width, use->height, use->linesize[0], step, offset, p);
+			if(g_m2s_track_have && contrast > 1.0)
+			{
+				// Compare against a held keyframe, not the previous frame: slow motion then adds up to
+				// whole pixels instead of being lost in per-frame rounding, and still frames can't drift.
+				if(m2s::AutoCalib::slide(g_m2s_track_prev, p, sh))
+				{
+					g_m2s_track_offset = sh;
+					if(std::fabs(sh) >= 24)
+					{
+						g_m2s_track_px += sh; g_m2s_track_offset = 0;
+						std::copy(p, p + m2s::AutoCalib::N, g_m2s_track_prev);
+					}
+				}
+				else
+					g_m2s_track_bad++;
+			}
+			else if(!g_m2s_track_have)
+				std::copy(p, p + m2s::AutoCalib::N, g_m2s_track_prev);
+			g_m2s_track_have = true; g_m2s_track_frames++;
+		}
+		if(!g_m2s_track_on && !g_m2s_t2d_on)
+			g_m2s_frame_wanted = false;
+	}
+	if(sw)
+		av_frame_free(&sw);
+}
