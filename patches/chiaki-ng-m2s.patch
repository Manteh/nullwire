+
+// Own high-priority thread: mouse updates must not wait for the UI or video drawing.
+void StreamSession::MouseThreadMain()
+{
+#ifdef Q_OS_MACOS
+	pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+	using clk = std::chrono::steady_clock;
+	auto next = clk::now() + std::chrono::milliseconds(4), last = clk::now(), stat_start = last;
+	int ticks = 0; double worst = 0;
+	while(!mouse_thread_stop)
+	{
+		std::this_thread::sleep_until(next);
+		auto now = clk::now();
+		const auto period = std::chrono::milliseconds(g_m2s_tick_ms.load());
+		next += period;
+		if(next < now) next = now + period;      // fell behind: don't burst to catch up
+		double dt = std::chrono::duration<double>(now - last).count();
+		last = now;
+		worst = std::max(worst, dt);
+		ticks++;
+		std::lock_guard<std::mutex> l(mouse_mutex);
+		MouseBridgeStep(dt);
+		if(std::chrono::duration<double>(now - stat_start).count() >= 1.0)
+		{
+			unsigned ev = MacMouse::takeEventCount();
+			if(MacMouse::captured() && ev > 0)
+				fprintf(stderr, "[m2s] rate: mouse reports=%u/s bridge updates=%d/s sends=%d/s worst gap=%.0f ms | main thread=%d/s worst gap=%d ms\n",
+					ev, ticks, mouse_sends, worst * 1000, g_m2s_main_ticks.load(), g_m2s_main_gap.load());
+			ticks = 0; worst = 0; mouse_sends = 0; stat_start = now;
+			g_m2s_main_ticks = 0; g_m2s_main_gap = 0;
+		}
+	}
+#endif
+}
+
+void StreamSession::MouseBridgeStep(double dt)
+{
+#ifdef Q_OS_MACOS
+	auto *m = static_cast<m2s::MouseToStick *>(mouse_m2s);
+	ChiakiControllerState prev = mouse_state;
+	m2s::CalibResult cal;
+	if(g_m2s_calib.takeFinished(cal))
+	{
+		if(cal.ok)
+		{
+			m->p.deadzone = cal.deadzone; m->p.wmax_deg_s = cal.wmax_deg_s; m->p.curve = cal.curve;
+			g_m2s_last_cal = cal;
+			m->reset();
+			bool saved = m2s::saveConfig(m2sConfigPath(), m->p);
+			fprintf(stderr, "[m2s] CALIBRATED: deadzone %.3f, full stick %.0f deg/s%s, stick-to-picture delay %.0f ms, ramp ratio %.2f%s, saved=%d\n",
+				cal.deadzone, cal.wmax_deg_s, cal.wmax_estimated ? " (estimate)" : "", cal.latency_ms, cal.ramp_ratio,
+				cal.ramp_detected ? " RAMP-UP DETECTED: turn off Aim Ease In and Aim Smoothing, then calibrate again" : "", saved);
+			for(const auto &c : cal.curve)
+				fprintf(stderr, "[m2s]   stick %.3f -> %3.0f%% speed\n", c.stick, c.frac * 100);
+			if(!cal.message.empty())
+				fprintf(stderr, "[m2s]   note: %s\n", cal.message.c_str());
+			MacMouse::beep(1);
+		}
+		else
+		{
+			g_m2s_last_cal = cal;
+			fprintf(stderr, "[m2s] CALIBRATION FAILED: %s\n", cal.message.c_str());
+			MacMouse::beep(3);
+		}
+		chiaki_controller_state_set_idle(&mouse_state);
+		MouseSendLocked();
+		return;
+	}
+	if(g_m2s_calib.active())
+	{
+		if(!MacMouse::captured()) { g_m2s_calib.abort(); return; }
+		double ignore_x, ignore_y; MacMouse::takeDeltas(ignore_x, ignore_y);
+		mouse_state.right_x = (int16_t)std::lround(std::clamp(g_m2s_calib.stick(m2sNow()), -1.0, 1.0) * 32767.0);
+		mouse_state.right_y = 0;
+		mouse_state.r2_state = mouse_state.l2_state = 0;
+		if(mouse_state.right_x != prev.right_x || mouse_state.right_y != prev.right_y)
+			MouseSendLocked();
+		return;
+	}
+	if(!MacMouse::captured())
+	{
+		if(prev.right_x || prev.right_y || prev.l2_state || prev.r2_state || (prev.buttons & CHIAKI_CONTROLLER_BUTTON_R3))
+		{
+			m->reset();
+			chiaki_controller_state_set_idle(&mouse_state);
+			MouseSendLocked();
+		}
+		return;
+	}
+	double dx, dy; MacMouse::takeDeltas(dx, dy);
+	if(g_m2s_hold_on)
+	{
+		mouse_state.right_x = (int16_t)std::lround(g_m2s_hold_x.load() * 32767.0);
+		mouse_state.right_y = (int16_t)std::lround(-g_m2s_hold_y.load() * 32767.0);
+		if(mouse_state.right_x != prev.right_x || mouse_state.right_y != prev.right_y) MouseSendLocked();
+		return;
+	}
+	if(g_m2s_sweep)
+	{
+		g_m2s_sweep_v += dt * 0.02;   // 2% stick per second, reaction time is subtracted when it stops
+		if(g_m2s_sweep_v > 0.4) { g_m2s_sweep = false; g_m2s_sweep_v = 0; fprintf(stderr, "[m2s] DEADZONE SWEEP gave up at 40%%\n"); }
+		mouse_state.right_x = (int16_t)std::lround(g_m2s_sweep_v * 32767.0);
+		mouse_state.right_y = 0;
+		MouseSendLocked();
+		return;
+	}
+	if(g_m2s_cal_ticks > 0) { g_m2s_cal_ticks--; dx += (g_m2s_cal_frac * m->p.wmax_deg_s * 4.0 / m->p.deg_per_count) / 1000.0; }   // 4 s spin at a fixed fraction of full stick
+	m->addDelta(dx, dy);
+	m2s::Stick s = m->tick(dt);
+	g_m2s_ring[g_m2s_ring_n++ % 2600] = {m2sNow(), dx, dy, s.x, s.y};
+	unsigned b = MacMouse::buttons();
+	mouse_state.right_x = (int16_t)std::lround(std::clamp(s.x, -1.0, 1.0) * 32767.0);
+	mouse_state.right_y = (int16_t)std::lround(std::clamp(-s.y, -1.0, 1.0) * 32767.0);   // PS: up is negative
+	mouse_state.r2_state = (b & 1) ? 0xff : 0;
+	mouse_state.l2_state = (b & 2) ? 0xff : 0;
+	if(b & 4) mouse_state.buttons |= CHIAKI_CONTROLLER_BUTTON_R3; else mouse_state.buttons &= ~CHIAKI_CONTROLLER_BUTTON_R3;
+	if(mouse_state.right_x != prev.right_x || mouse_state.right_y != prev.right_y || mouse_state.r2_state != prev.r2_state ||
+	   mouse_state.l2_state != prev.l2_state || mouse_state.buttons != prev.buttons)
+		MouseSendLocked();
+#endif
+}
+
 void StreamSession::HandleKeyboardEvent(QKeyEvent *event)
 {
+#ifdef Q_OS_MACOS
+	if(event->type() == QEvent::KeyPress && !event->isAutoRepeat() && mouse_m2s)
+	{
+		std::lock_guard<std::mutex> mouse_lock(mouse_mutex);
+		auto *m = static_cast<m2s::MouseToStick *>(mouse_m2s);
+		bool changed = true;
+		switch(event->key())
+		{
+			case Qt::Key_section:     // § key (Nordic layout, under Esc)
+			case Qt::Key_QuoteLeft:   // ` (US layout)
+			case Qt::Key_AsciiTilde:
+			case Qt::Key_F8:  MacMouse::setCapture(!MacMouse::captured()); changed = false;
+				fprintf(stderr, "[m2s] mouse bridge: %s\n", MacMouse::captured() ? "CAPTURED (` to release)" : "released"); break;
+			case Qt::Key_Less:
+			case Qt::Key_Greater: {
+				static const double fr[] = {0.25, 0.5, 0.75, 1.0};
+				g_m2s_cal_frac = fr[g_m2s_cal_level++ % 4]; g_m2s_cal_ticks = 1000; changed = false;
+				fprintf(stderr, "[m2s] TEST SPIN %.0f%% stick: expecting %.2f full turns over 4 s\n", g_m2s_cal_frac * 100, g_m2s_cal_frac * m->p.wmax_deg_s * 4 / 360.0);
+				break; }
+			case Qt::Key_J: m->p.window_ms = std::max(16.0, m->p.window_ms - 8); break;   // j  less delay
+			case Qt::Key_K: m->p.window_ms = std::min(64.0, m->p.window_ms + 8); break;   // k  steadier
+			case Qt::Key_B:           // b  start or cancel the automatic calibration
+				changed = false;
+				if(g_m2s_calib.active()) g_m2s_calib.abort();
+				else
+				{
+					MacMouse::setCapture(true);
+					g_m2s_sweep = false; g_m2s_cal_ticks = 0; m->reset();
+					g_m2s_calib.start(m2sNow());
+					fprintf(stderr, "[m2s] CALIBRATION started\n");
+				}
+				break;
+			case Qt::Key_1:
+			case Qt::Key_L: {
+				// "that just hitched": save the last 10 seconds. Being a second or two late is fine.
+				changed = false;
+				double now = m2sNow(), ep = m2sEpoch();
+				QString dir = QDir::homePath() + "/Library/Application Support/m2s-bridge/hitches";
+				QDir().mkpath(dir);
+				std::string path = (dir + QString("/hitch_%1.txt").arg((qint64)ep)).toStdString();
+				if(FILE *o = fopen(path.c_str(), "w"))
+				{
+					long n = std::min<long>(g_m2s_ring_n, 2600);
+					fprintf(o, "mark %.4f\n", now);
+					for(long i = g_m2s_ring_n - n; i < g_m2s_ring_n; i++)
+					{
+						const M2sTick &k = g_m2s_ring[i % 2600];
+						fprintf(o, "in %.4f %.1f %.1f %.4f %.4f\n", k.t, k.dx, k.dy, k.sx, k.sy);
+					}
+					std::lock_guard<std::mutex> tl(g_m2s_test_mtx);
+					for(const auto &v : g_m2s_seen) if(v.t > now - 10.5) fprintf(o, "seen %.4f %.3f %.3f\n", v.t, v.a, v.b);
+					fclose(o);
+				}
+				fprintf(stderr, "[m2s] HITCH MARK saved %s\n", path.c_str()); fflush(stderr);
+				MacMouse::beep(1);
+				break; }
+			case Qt::Key_N: m->p.curve.clear(); m->p.deadzone = std::max(0.0, m->p.deadzone - 0.01); break;   // n  deadzone down (camera hops)
+			case Qt::Key_M: m->p.curve.clear(); m->p.deadzone = std::min(0.4, m->p.deadzone + 0.01); break;   // m  deadzone up (small moves ignored)
+			case Qt::Key_Apostrophe:
