+// Test channel (only with M2S_TEST set, only on localhost): lets a script drive and measure the bridge.
+void StreamSession::MouseTestChannelMain()
+{
+#ifdef Q_OS_MACOS
+	int fd = socket(AF_INET, SOCK_DGRAM, 0);
+	sockaddr_in a{}; a.sin_family = AF_INET; a.sin_port = htons(47999); a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	timeval tv{0, 200000}; setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	if(bind(fd, (sockaddr *)&a, sizeof(a)) != 0) { fprintf(stderr, "[m2s] test channel: bind failed\n"); close(fd); return; }
+	fprintf(stderr, "[m2s] test channel on 127.0.0.1:47999\n");
+	static const std::map<std::string, uint32_t> btn = {
+		{"cross", CHIAKI_CONTROLLER_BUTTON_CROSS}, {"moon", CHIAKI_CONTROLLER_BUTTON_MOON}, {"box", CHIAKI_CONTROLLER_BUTTON_BOX},
+		{"pyramid", CHIAKI_CONTROLLER_BUTTON_PYRAMID}, {"up", CHIAKI_CONTROLLER_BUTTON_DPAD_UP}, {"down", CHIAKI_CONTROLLER_BUTTON_DPAD_DOWN},
+		{"left", CHIAKI_CONTROLLER_BUTTON_DPAD_LEFT}, {"right", CHIAKI_CONTROLLER_BUTTON_DPAD_RIGHT}, {"l1", CHIAKI_CONTROLLER_BUTTON_L1},
+		{"r1", CHIAKI_CONTROLLER_BUTTON_R1}, {"l3", CHIAKI_CONTROLLER_BUTTON_L3}, {"r3", CHIAKI_CONTROLLER_BUTTON_R3},
+		{"options", CHIAKI_CONTROLLER_BUTTON_OPTIONS}, {"share", CHIAKI_CONTROLLER_BUTTON_SHARE}, {"ps", CHIAKI_CONTROLLER_BUTTON_PS},
+		{"touchpad", CHIAKI_CONTROLLER_BUTTON_TOUCHPAD}};
+	char buf[512];
+	while(!mouse_thread_stop)
+	{
+		sockaddr_in from{}; socklen_t fl = sizeof(from);
+		ssize_t n = recvfrom(fd, buf, sizeof(buf) - 1, 0, (sockaddr *)&from, &fl);
+		if(n <= 0) continue;
+		buf[n] = 0;
+		char word[64] = {0}, arg[400] = {0}; double a1 = 0, a2 = 0, a3 = 0;
+		sscanf(buf, "%63s", word);
+		std::string reply = "ok";
+		std::string cmd = word;
+		if(cmd == "press" && sscanf(buf, "%*s %399s %lf", arg, &a1) >= 1 && btn.count(arg))
+		{
+			{ std::lock_guard<std::mutex> l(mouse_mutex); mouse_state.buttons |= btn.at(arg); MouseSendLocked(); }
+			std::this_thread::sleep_for(std::chrono::milliseconds((int)(a1 > 0 ? a1 : 120)));
+			{ std::lock_guard<std::mutex> l(mouse_mutex); mouse_state.buttons &= ~btn.at(arg); MouseSendLocked(); }
+		}
+		else if(cmd == "lstick" && sscanf(buf, "%*s %lf %lf %lf", &a1, &a2, &a3) == 3)
+		{
+			{ std::lock_guard<std::mutex> l(mouse_mutex); mouse_state.left_x = (int16_t)(a1 * 32767); mouse_state.left_y = (int16_t)(-a2 * 32767); MouseSendLocked(); }
+			std::this_thread::sleep_for(std::chrono::milliseconds((int)a3));
+			{ std::lock_guard<std::mutex> l(mouse_mutex); mouse_state.left_x = 0; mouse_state.left_y = 0; MouseSendLocked(); }
+		}
+		else if(cmd == "capture" && sscanf(buf, "%*s %lf", &a1) == 1) MacMouse::setHeadlessCapture(a1 != 0);
+		else if(cmd == "mouse" && sscanf(buf, "%*s %lf %lf", &a1, &a2) == 2) MacMouse::inject(a1, a2);
+		else if(cmd == "hold" && sscanf(buf, "%*s %lf %lf", &a1, &a2) == 2)
+		{
+			// exact stick value for an exact time, bypassing the conversion
+			auto end = std::chrono::steady_clock::now() + std::chrono::microseconds((long long)(a2 * 1000));
+			g_m2s_hold_x = a1; g_m2s_hold_on = true;
+			std::this_thread::sleep_until(end);
+			g_m2s_hold_x = 0;
+			std::this_thread::sleep_for(std::chrono::milliseconds(8));
+			g_m2s_hold_on = false;
+		}
+		else if(cmd == "bed") { QMetaObject::invokeMethod(this, [this]{ GoToBed(); }, Qt::QueuedConnection); }
+		else if(cmd == "quit") { QMetaObject::invokeMethod(this, [this]{ Stop(); }, Qt::QueuedConnection); }
+		else if(cmd == "lset" && sscanf(buf, "%*s %lf %lf", &a1, &a2) == 2)
+		{
+			std::lock_guard<std::mutex> l(mouse_mutex);
+			mouse_state.left_x = (int16_t)(a1 * 32767); mouse_state.left_y = (int16_t)(-a2 * 32767); MouseSendLocked();
+		}
+		else if(cmd == "btn" && sscanf(buf, "%*s %399s %lf", arg, &a1) == 2 && btn.count(arg))
+		{
+			std::lock_guard<std::mutex> l(mouse_mutex);
+			if(a1 != 0) mouse_state.buttons |= btn.at(arg); else mouse_state.buttons &= ~btn.at(arg);
+			MouseSendLocked();
+		}
+		else if(cmd == "fire" && sscanf(buf, "%*s %lf", &a1) == 1) MacMouse::setTestButtons(a1 != 0 ? 1 : 0);
+		else if(cmd == "hold2" && sscanf(buf, "%*s %lf %lf %lf", &a1, &a2, &a3) == 3)
+		{
+			// exact stick x and y (+y up) for an exact time, bypassing the conversion
+			auto end = std::chrono::steady_clock::now() + std::chrono::microseconds((long long)(a3 * 1000));
+			g_m2s_hold_x = a1; g_m2s_hold_y = a2; g_m2s_hold_on = true;
