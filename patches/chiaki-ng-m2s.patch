+			std::lock_guard<std::mutex> l(g_m2s_test_mtx);
+			char o[120]; snprintf(o, sizeof(o), "%.3f %d %d", g_m2s_track_px + g_m2s_track_offset, g_m2s_track_frames, g_m2s_track_bad);
+			reply = o;
+		}
+		else if(cmd == "set" && sscanf(buf, "%*s %399s %lf", arg, &a1) == 2)
